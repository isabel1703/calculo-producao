<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Conferência de Produção por Turno</title>

<style>
body {
  font-family: Arial, sans-serif;
  background: linear-gradient(135deg, #5e35b1, #7e57c2);
  padding: 20px;
}

.box {
  background: #ffffff;
  max-width: 520px;
  margin: auto;
  padding: 20px;
  border-radius: 10px;
}

h2 {
  color: #5e35b1;
  text-align: center;
}

label {
  font-weight: bold;
  margin-top: 10px;
  display: block;
}

input, select, button {
  width: 100%;
  padding: 8px;
  margin-top: 5px;
}

button {
  background: #5e35b1;
  color: white;
  border: none;
  margin-top: 15px;
  font-size: 16px;
  cursor: pointer;
  border-radius: 5px;
}

.resultado {
  margin-top: 20px;
  padding: 10px;
  border-radius: 5px;
  font-weight: bold;
}
.ok { background: #e8f5e9; color: #2e7d32; }
.falta { background: #fff3e0; color: #ef6c00; }
.passou { background: #fdecea; color: #c62828; }
</style>
</head>

<body>

<div class="box">
<h2>Conferência de Produção – Turno</h2>

<label>Ml da garrafa</label>
<select id="ml" onchange="configurar()">
  <option value="">Selecione</option>
  <option value="200">200ml</option>
  <option value="250">250ml</option>
  <option value="350">350ml</option>
  <option value="510">510ml</option>
  <option value="600">600ml</option>
  <option value="1L">1L</option>
  <option value="2L">2L</option>
  <option value="2LCP">2L CP</option>
  <option value="5L">5L</option>
  <option value="corote">Corote</option>
</select>

<label>Produção</label>
<input type="number" id="producao">

<label>Palets produzidos</label>
<input type="number" id="palets">

<label>Fardos avulsos</label>
<input type="number" id="fardos">

<label>Garrafas avulsas</label>
<input type="number" id="avulsas">

<label>Garrafas do Turno anterior</label>
<input type="number" id="turnoAnterior">

<label>Garrafas do Estoque</label>
<input type="number" id="estoque">

<label>Perda de garrafas</label>
<input type="number" id="perda">

<button onclick="calcular()">Calcular</button>

<div id="resultado" class="resultado"></div>
</div>

<script>
let produto = {};

function configurar() {
  const ml = document.getElementById("ml").value;

  if (ml === "200") produto = { fardo: 140, palet: 14 };
  if (ml === "250") produto = { fardo: 406, palet: 12 };
  if (ml === "350") produto = { fardo: 325, palet: 12 };
  if (ml === "510") produto = { fardo: 325, palet: 12 };
  if (ml === "600") produto = { fardo: 253, palet: 11 };
  if (ml === "2L") produto = { fardo: 140, palet: 8 };
  if (ml === "corote") produto = { fardo: 171, palet: 19 };
  if (ml === "5L") produto = { fardo: 49, palet: 8 };
  if (ml === "2LCP") produto = { fardo: 120, palet: 9 };
}

function calcular() {
  const producao = Number(producaoInput.value);
  const palets = Number(paletsInput.value);
  const fardos = Number(fardosInput.value);
  const avulsas = Number(avulsasInput.value);
  const turnoAnterior = Number(turnoAnteriorInput.value);
  const estoque = Number(estoqueInput.value);
  const perda = Number(perdaInput.value);

  const total =
    (palets * produto.palet * produto.fardo) +
    (fardos * produto.fardo) +
    avulsas +
    turnoAnterior -
    estoque -
    perda;

  const diferenca = total - producao;

  let texto = `
    Total embalado: ${total}<br>
    Produção: ${producao}<br>
  `;

  if (diferenca === 0) {
    resultado.className = "resultado ok";
    texto += "✔️ BATEU com a produção";
  } else if (diferenca > 0) {
    resultado.className = "resultado passou";
    texto += `❌ PASSOU da produção em ${diferenca} garrafas`;
  } else {
    resultado.className = "resultado falta";
    texto += `⚠️ FALTOU ${Math.abs(diferenca)} garrafas`;
  }

  resultado.innerHTML = texto;
}

const producaoInput = document.getElementById("producao");
const paletsInput = document.getElementById("palets");
const fardosInput = document.getElementById("fardos");
const avulsasInput = document.getElementById("avulsas");
const turnoAnteriorInput = document.getElementById("turnoAnterior");
const estoqueInput = document.getElementById("estoque");
const perdaInput = document.getElementById("perda");
const resultado = document.getElementById("resultado");
</script>

</body>
</html>
